          "type": "string",
          "maxLength": 150
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "zone": {
          "type": "string",
          "maxLength": 50
        },
        "isAdventist": {
          "type": "boolean"
        },
        "yearsServing": {
          "type": "number"
        },
        "maritalStatus": {
          "type": "string",
          "enum": [
            "soltero",
            "casado"
          ]
        },
        "bio": {
          "type": "string",
          "maxLength": 500
        },
        "points": {
          "type": "number"
        },
        "level": {
          "type": "number"
        },
        "levelName": {
          "type": "string",
          "maxLength": 50
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "moderator",
            "admin",
            "superadmin"
          ]
        },
        "followingIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "followerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isOfficialVerified": {
          "type": "boolean"
