    "User": {
      "title": "User",
      "description": "Perfil de usuario y ficha de jugador juvenil cristiano",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "avatar": {
          "type": "string",
          "maxLength": 500
        },
        "age": {
          "type": "number"
        },
